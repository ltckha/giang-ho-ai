{
  "name": "giang-ho-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Gọn Phố — game thủ thành ngũ hành giữ tiệm trên phố thật Đà Lạt (Phaser 3 + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "make:street": "esbuild tools/level-maker/make-street.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/make-street.cjs && node node_modules/.cache/make-street.cjs",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "make:map": "python3 tools/level-maker/make_street_map.py"
  },
  "dependencies": {
    "phaser": "^3.88.2",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
